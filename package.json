{
  "name": "@neuraiproject/neurai-create-transaction",
  "version": "0.9.2",
  "description": "Local Neurai raw transaction creation helpers for browser and Node environments",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser.js"
    },
    "./global": "./dist/NeuraiCreateTransaction.global.js",
    "./amounts": {
      "import": {
        "types": "./dist/amounts.d.ts",
        "default": "./dist/amounts.js"
      },
      "require": {
        "types": "./dist/amounts.d.cts",
        "default": "./dist/amounts.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && rollup -c rollup.config.mjs && rollup -c rollup.dts.config.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run && npm run test:types",
    "test:types": "tsc -p tsconfig.types.json && tsc -p tsconfig.types-node16.json && tsc -p tsconfig.types-bundler.json",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neuraiproject/neurai-key": "^5.0.3",
    "@noble/hashes": "^2.2.0",
    "bech32": "^2.0.0",
    "bs58": "^6.0.0",
    "bs58check": "^4.0.0"
  },
  "keywords": [
    "neurai",
    "transaction",
    "rawtx",
    "assets",
    "pq"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.1.2",
    "rollup": "^4.52.4",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
